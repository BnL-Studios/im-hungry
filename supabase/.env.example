# Mobilappens variabler ska ligga i mobile/.env (se mobile/.env.example).

# Används vid CLI-koppling (npx supabase link --project-ref <id>)
SUPABASE_PROJECT_ID=ditt-project-id

# Endast för lokal testkörning av Edge Functions (supabase/.env)
# Koden läser GEMINI_API. Vid lokal körning måste den finnas i --allow-env.
GEMINI_API=din-gemini-api-key

# Valfritt: kodens standard är gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Valfritt: reservmodell som provas om primära försöken misslyckas.
# GEMINI_BACKUP_MODEL=gemini-3.8-flash

EXPO_PUBLIC_SUPABASE_URL=https://ditt-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=din-publika-anon-key