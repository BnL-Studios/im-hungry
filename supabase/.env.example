# Mobilappens variabler ska ligga i mobile/.env (se mobile/.env.example).

# Används vid CLI-koppling (npx supabase link --project-ref <id>)
SUPABASE_PROJECT_ID=ditt-project-id

# Endast för lokal körning av Edge Functions (ignoreras av Git).
# Koden läser GEMINI_API; äldre dokumentation använde GEMINI_API_KEY.
GEMINI_API=din-gemini-api-key

# Valfritt: kodens standard är gemini-3.5-flash-lite, designvalet gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_BACKUP_MODEL=gemini-3.5-flash-lite

EXPO_PUBLIC_SUPABASE_URL=https://ditt-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=din-publika-anon-key