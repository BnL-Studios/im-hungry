# Mobilappens variabler ska ligga i mobile/.env (se mobile/.env.example).

# Används vid CLI-koppling (npx supabase link --project-ref <id>)
SUPABASE_PROJECT_ID=ditt-project-id

# Endast för lokal testkörning av Edge Functions (supabase/.env.local)
GEMINI_API_KEY=din-gemini-api-key

EXPO_PUBLIC_SUPABASE_URL=https://ditt-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=din-publika-anon-key