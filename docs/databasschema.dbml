// Utkast: lokal SQLite på mobilen. Drizzle-schema och migrationer
// blir teknisk sanningskälla när de implementeras.
Project im_hungry {
  database_type: 'SQLite'
  Note: 'Lokalt matförråd i MVP. Supabase Edge Function används enbart som AI-gateway.'
}

Table inventory_items {
  id integer [pk, increment]
  name text [not null]
  quantity real [not null, note: 'Mängd > 0; valideras i appen och med SQLite CHECK i migrationen']
  unit text [not null, note: 'g, ml eller pcs; valideras i appen och med SQLite CHECK i migrationen']

  Note: 'En tabell per appinstallation, ingen synkronisering eller receptlagring i MVP.'
}
